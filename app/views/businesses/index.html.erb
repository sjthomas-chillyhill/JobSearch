
<div class="d-flex justify-content-between align-items-center mb-4">
  <h2>Companies (<span><%= (@businesses && @businesses.count) || 0 %></span>)</h2>
  <div>
        <%= link_to "New Company", new_business_path, class: "btn btn-primary" %>
    </div>
</div>
<div class="row">
  <div class="col-md-10 offset-md-1">
    <!-- p id="notice"><%= notice %></p -->
    <% if @businesses and @businesses.size > 0 %>

      <div class="table-responsive">
        <table class="table table-sm table-hover">
          <thead>
          <tr>
            <th>Name</th>
            <th>Address</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Url</th>
            <th></th>
          </tr>
          </thead>

          <tbody>
          <%= render @businesses %>
          </tbody>
        </table>
      </div>
    <% end %>
    <br>
   </div>
</div>