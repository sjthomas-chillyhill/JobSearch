<div class="card">
  <div class="card-body">
    <div class="row">
      <div class="col-md-6">
        <h4>Business Information</h4>
        <table class="table table-borderless">
          <tr>
            <td><strong>Name:</strong></td>
            <td><%= @business.name %></td>
          </tr>
          <tr>
            <td><strong>Address:</strong></td>
            <td><%= @business.address %></td>
          </tr>
          <tr>
            <td><strong>Email:</strong></td>
            <td><%= mail_to @business.email, @business.email %></td>
          </tr>
          <tr>
            <td><strong>Phone:</strong></td>
            <td><%= @business.phone %></td>
          </tr>
          <tr>
            <td><strong>Website:</strong></td>
            <td><%= link_to @business.url, @business.url, target: "_blank", rel: "noopener" if @business.url.present? %></td>
          </tr>
        </table>
      </div>
    </div>
  </div>
</div>