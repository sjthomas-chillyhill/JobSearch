<div class="business-details">
    <h4>Business Information</h4>
    
    <div class="mb-3">
      <div class="row">
        <div class="col-sm-3"><strong>Name:</strong></div>
        <div class="col-sm-9"><%= @business.name %></div>
      </div>
    </div>
    
    <div class="mb-3">
      <div class="row">
        <div class="col-sm-3"><strong>Address:</strong></div>
        <div class="col-sm-9"><%= @business.address %></div>
      </div>
    </div>
    
    <div class="mb-3">
      <div class="row">
        <div class="col-sm-3"><strong>Email:</strong></div>
        <div class="col-sm-9"><%= mail_to @business.email, @business.email %></div>
      </div>
    </div>
    
    <div class="mb-3">
      <div class="row">
        <div class="col-sm-3"><strong>Phone:</strong></div>
        <div class="col-sm-9"><%= @business.phone %></div>
      </div>
    </div>
    
    <div class="mb-3">
      <div class="row">
        <div class="col-sm-3"><strong>Website:</strong></div>
        <div class="col-sm-9">
          <%= link_to @business.url, @business.url, target: "_blank", rel: "noopener" if @business.url.present? %>
        </div>
      </div>
    </div>
</div>