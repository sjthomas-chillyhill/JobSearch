<% content_for :title, "Editing application" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Editing Application</h1>
  <div>
    <%= link_to "Show this application", @application, class: "btn btn-outline-primary me-2" %>
    <%= link_to "Back to applications", applications_path, class: "btn btn-secondary" %>
  </div>
</div>

<div class="row">
  <div class="col-md-6 offset-md-3">
    <% @actionName="Update" %>
    <div class="card">
      <div class="card-body">
        <%= render "form", application: @application %>
      </div>
    </div>
  </div>
</div>