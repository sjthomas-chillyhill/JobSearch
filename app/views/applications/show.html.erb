
<% content_for :title, "Application Details" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><%= @application.position %></h1>
  <div>
    <%= link_to "Back", applications_path, class: "btn btn-secondary" %>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <% if notice %>
      <div class="alert alert-success"><%= notice %></div>
    <% end %>
   
    <div class="table-responsive">
      <table class="table table-sm table-hover">
        <thead>
          <tr>
            <th>Date</th>
            <th>Company</th>
            <th>Position</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>

        <tbody>
          <%= render @application %>
        </tbody>
      </table>
    </div>
  </div>
</div>