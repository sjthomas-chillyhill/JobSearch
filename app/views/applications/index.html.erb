
<div class="row">
  <div class="col-xs-2">
    <h2>Applications (<span><%= (@applications && @applications.count) || 0 %></span>)</h2>
  </div>

</div>
<div class="row">
  <div class="col-md-10 col-md-offset-1">
    <!-- p id="notice"><%= notice %></p -->
    <% if @applications and @applications.size > 0 %>

      <div class="table-responsive">
        <table class="table table-condensed table-hover">
          <thead>
          <tr>
            <th>Date</th>
            <th>Company</th>
            <th>Position</th>
            <th>Status</th>
            <th></th>
          </tr>
          </thead>

          <tbody>
          <%= render @applications %>
          </tbody>
        </table>
      </div>
    <% end %>
    <br>
  <%= link_to "New Application", new_application_path %>
   </div>
</div>
